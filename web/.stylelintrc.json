{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-tailwindcss"
  ],
  "overrides": [
    {
      "files": ["**/*.jsx"],
      "customSyntax": "postcss-styled-syntax"
    }
  ],
  "rules": {
    "no-descending-specificity": null,
    "selector-class-pattern": "^[a-z][a-z0-9]*(?:[-_]{1,2}[a-z0-9]+)*$"
  }
}
