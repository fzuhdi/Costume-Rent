{
  "project_name": "Costume Rent",
  "path": "C:/Users/fzuhd/OneDrive/Documents/Project/Costume Rent",
  "description": "Costume Rental Management System - Fullstack React + Go + SQLite + Docker",
  "last_updated": "2026-04-26",
  "technologies": {
    "backend": {
      "language": "Go 1.22+",
      "framework": "Gin",
      "orm": "GORM",
      "database": "SQLite",
      "auth": "JWT + bcrypt"
    },
    "frontend": {
      "framework": "React 18",
      "build": "Vite",
      "routing": "React Router v6",
      "http": "Axios",
      "icons": "Lucide React"
    },
    "devops": {
      "containerization": "Docker + Docker Compose",
      "proxy": "Nginx"
    }
  },
  "structure": {
    "backend": [
      "main.go",
      ".env",
      "go.mod",
      "config/database.go",
      "middleware/auth.go",
      "middleware/cors.go",
      "models/models.go",
      "handlers/*.go",
      "services/*.go",
      "dto/*.go",
      "routes/routes.go",
      "Dockerfile",
      ".dockerignore"
    ],
    "frontend": [
      "index.html",
      "package.json",
      "vite.config.js",
      "Dockerfile",
      "nginx.conf",
      "src/main.jsx",
      "src/App.jsx",
      "src/api/*.js",
      "src/context/*.jsx",
      "src/components/*.jsx",
      "src/pages/*.jsx",
      "src/styles/*.css"
    ],
    "root": [
      ".gitignore",
      "docker-compose.yml",
      ".env.production",
      "project-plan.md"
    ]
  },
  "api_endpoints": {
    "auth": ["POST /api/auth/login", "GET /api/auth/me", "POST /api/auth/logout"],
    "costumes": ["GET /api/costumes", "GET /api/costumes/:id", "POST /api/costumes", "PUT /api/costumes/:id", "DELETE /api/costumes/:id"],
    "clients": ["GET /api/clients", "GET /api/clients/:id", "POST /api/clients", "PUT /api/clients/:id", "DELETE /api/clients/:id"],
    "rents": ["GET /api/rents", "GET /api/rents/:id", "POST /api/rents", "PUT /api/rents/:id", "PUT /api/rents/:id/return", "DELETE /api/rents/:id"],
    "notifications": ["GET /api/notifications"],
    "settings": ["GET /api/settings", "PUT /api/settings", "POST /api/settings/logo"]
  },
  "default_credentials": {
    "email": "admin@busana.com",
    "password": "admin123"
  },
  "docker_commands": {
    "start": "docker compose up --build -d",
    "stop": "docker compose down",
    "logs_backend": "docker compose logs -f backend",
    "logs_frontend": "docker compose logs -f frontend",
    "backup_db": "docker run --rm -v busana_db:/data -v $(pwd)/backup:/backup alpine sh -c \"cp /data/busana_tari.db /backup/busana_$(date +%Y%m%d).db\""
  },
  "dev_commands": {
    "backend": "cd backend && GOROOT=/c/Go/go PATH=/c/Go/go/bin:$PATH go run main.go",
    "frontend": "cd frontend && npm install && npm run dev"
  }
}