{
  "schema_version": 1,
  "project": {
    "name": "Costume Rental",
    "adapter_path": ".opencode/project.json"
  },
  "acceptance": {
    "dir": "docs/acceptance",
    "id_pattern": "^[A-Z][A-Z0-9_]*-[0-9]{3}$",
    "status": [
      "draft",
      "ready",
      "covered",
      "retired"
    ]
  },
  "features": {
    "AUTH": {
      "name": "Authentication",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/auth.spec.js"
      ]
    },
    "CATALOGUE": {
      "name": "Costume Management",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/catalogue.spec.js"
      ]
    },
    "RENT": {
      "name": "Rental System",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/rental.spec.js"
      ]
    },
    "CLIENT": {
      "name": "Client Management",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/clients.spec.js"
      ]
    },
    "NOTIFICATION": {
      "name": "Notifications",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/notifications.spec.js"
      ]
    },
    "SETTINGS": {
      "name": "Settings",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/settings.spec.js"
      ]
    },
    "NAVIGATION": {
      "name": "Navigation and UI",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/navigation.spec.js"
      ]
    },
    "API": {
      "name": "API Backend",
      "test_type": "api",
      "spec_files": [
        "test/specs/api.spec.js"
      ]
    }
  },
  "code_roots": [
    "backend",
    "frontend"
  ],
  "test_roots": [
    "test"
  ],
  "protected_paths": [
    ".env",
    ".env.*",
    "docker-compose.yml",
    "Dockerfile",
    "**/Dockerfile",
    "nginx.conf",
    "package.json",
    "package-lock.json",
    "backend/go.mod",
    "backend/go.sum",
    "frontend/package.json",
    "frontend/package-lock.json",
    "test/package.json",
    "test/package-lock.json"
  ],
  "test_types": [
    "e2e",
    "api"
  ],
  "commands": {
    "test_case": "cd test && npx playwright test {test_runner_spec_files} --grep \"{test_case_id}\"",
    "feature": "cd test && npx playwright test {test_runner_spec_files}",
    "manifest": "node .opencode/scripts/build-test-case-manifest.mjs",
    "manifest_check": "node .opencode/scripts/build-test-case-manifest.mjs --check"
  },
  "quality_gate": {
    "command": "node scripts/quality-gate.mjs"
  },
  "git": {
    "branch_prefix": "tdd/",
    "commit_scope": "tdd",
    "commit_default": true
  },
  "pr": {
    "provider": "github"
  },
  "agent_permissions": {
    "developer": {
      "read": [
        "backend/**",
        "frontend/**",
        "docs/tickets/**",
        "docs/acceptance/**",
        ".opencode/state/test-case-manifest.json"
      ],
      "write": [
        "backend/**",
        "frontend/**"
      ],
      "deny": [
        "test/**"
      ]
    },
    "sdet": {
      "read": [
        "test/**",
        "docs/acceptance/**",
        ".opencode/project.json"
      ],
      "write": [
        "test/**",
        ".opencode/state/test-case-manifest.json"
      ],
      "deny": [
        "backend/**",
        "frontend/**"
      ]
    },
    "reviewer": {
      "read": [
        "**/*"
      ],
      "write": []
    },
    "workflow-engineer": {
      "read": [
        ".opencode/**",
        "docs/**",
        "test/**",
        "AGENTS.md"
      ],
      "write": [
        ".opencode/**",
        "docs/**",
        "test/**",
        "AGENTS.md"
      ],
      "deny": [
        "backend/**",
        "frontend/**"
      ]
    },
    "orchestrator": {
      "read": [
        "docs/tickets/**",
        "docs/acceptance/**",
        "docs/plans/**",
        ".opencode/state/*.json",
        ".opencode/state.example/*.json",
        ".opencode/skills/**",
        ".opencode/project.json",
        "test/**",
        "backend/**",
        "frontend/**"
      ],
      "write": [
        "docs/tickets/**",
        "docs/plans/**",
        ".opencode/state/*.json",
        ".opencode/state.example/*"
      ],
      "deny": [
        ".opencode/opencode.json"
      ]
    }
  }
}
