{
  "schema_version": 2,
  "project": {
    "name": "Costume Rental",
    "adapter_path": ".opencode/project.json"
  },
  "acceptance": {
    "dir": "docs/acceptance",
    "id_pattern": "^[A-Z][A-Z0-9_]*-[0-9]{3}$",
    "status": [
      "draft",
      "ready",
      "covered",
      "retired"
    ]
  },
  "features": {
    "AUTH": {
      "name": "Authentication",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/auth.spec.js"
      ]
    },
    "CATALOGUE": {
      "name": "Costume Management",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/catalogue.spec.js"
      ]
    },
    "RENT": {
      "name": "Rental System",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/rental.spec.js"
      ]
    },
    "CLIENT": {
      "name": "Client Management",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/clients.spec.js"
      ]
    },
    "NOTIFICATION": {
      "name": "Notifications",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/notifications.spec.js"
      ]
    },
    "SETTINGS": {
      "name": "Settings",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/settings.spec.js"
      ]
    },
    "NAVIGATION": {
      "name": "Navigation and UI",
      "test_type": "e2e",
      "spec_files": [
        "test/specs/navigation.spec.js"
      ]
    },
    "API": {
      "name": "API Backend",
      "test_type": "api",
      "spec_files": [
        "test/specs/api.spec.js"
      ]
    }
  },
  "code_roots": [
    "backend",
    "frontend"
  ],
  "test_roots": [
    "test"
  ],
  "docs": {
    "root": "docs",
    "acceptance": "docs/acceptance",
    "plans": "docs/plans",
    "tickets": "docs/tickets",
    "workflow_changes": "docs/workflow-changes",
    "runbooks": "docs/runbooks"
  },
  "workflow": {
    "product_stages": [
      "design-ui",
      "integrate-backend",
      "deployment"
    ],
    "internal_stages": [
      "workflow-maintenance"
    ],
    "quality_policies": [
      "exploratory",
      "light-checks",
      "strict-tdd"
    ],
    "default_stage": "design-ui",
    "default_quality_policy": "exploratory",
    "legacy_mode_map": {
      "ui-tracer": {
        "workflow_stage": "design-ui",
        "quality_policy": "exploratory"
      },
      "light-implementation": {
        "workflow_stage": "integrate-backend",
        "quality_policy": "light-checks"
      },
      "strict-tdd": {
        "workflow_stage": "integrate-backend",
        "quality_policy": "strict-tdd"
      }
    },
    "enabled_modes": [
      "ui-tracer",
      "light-implementation",
      "strict-tdd",
      "parallel-runtime"
    ],
    "default_mode": "ui-tracer",
    "max_parallel": 3
  },
  "artifacts": {
    "root": ".artifacts",
    "playwright": {
      "output_dir": ".artifacts/playwright/test-results",
      "html_report": ".artifacts/playwright/html-report",
      "screenshots": ".artifacts/playwright/screenshots"
    },
    "playwright_mcp": ".artifacts/playwright-mcp",
    "opencode": ".artifacts/opencode"
  },
  "protected_paths": [
    ".env",
    ".env.*",
    "docker-compose.yml",
    "Dockerfile",
    "**/Dockerfile",
    "nginx.conf",
    "package.json",
    "package-lock.json",
    "backend/go.mod",
    "backend/go.sum",
    "frontend/package.json",
    "frontend/package-lock.json",
    "test/package.json",
    "test/package-lock.json"
  ],
  "test_types": [
    "e2e",
    "api"
  ],
  "commands": {
    "ui_smoke": "cd test && npx playwright test --project=ui:smoke",
    "ui_review": "cd test && npx playwright test --project=ui:review",
    "e2e_tdd": "cd test && npx playwright test --project=e2e:tdd {test_runner_spec_files} --grep \"{test_case_id}\"",
    "api": "cd test && npx playwright test --project=api",
    "visual": "cd test && npx playwright test --project=visual",
    "test_case": "cd test && npx playwright test {test_runner_spec_files} --grep \"{test_case_id}\"",
    "feature": "cd test && npx playwright test {test_runner_spec_files}",
    "manifest": "node .opencode/scripts/build-test-case-manifest.mjs",
    "manifest_check": "node .opencode/scripts/build-test-case-manifest.mjs --check"
  },
  "quality_gate": {
    "command": "node scripts/quality-gate.mjs"
  },
  "runtime": {
    "slot_step": 100,
    "base_ports": {
      "frontend": 5173,
      "backend": 8081,
      "sqlite": 8080
    },
    "compose": {
      "file": "docker-compose.dev.yml",
      "services": [
        "backend",
        "frontend"
      ]
    },
    "runtime_files": {
      "required": [
        "frontend/package-lock.json",
        "test/package-lock.json"
      ],
      "optional": []
    },
    "generated_env_files": [
      {
        "target": "backend/.env.ticket",
        "values": {
          "APP_ENV": "development",
          "PORT": "8080",
          "DB_PATH": "/app/data/busana_tari.db",
          "JWT_SECRET": "dev-only-ticket-jwt-secret",
          "JWT_EXPIRES_HOURS": "24",
          "NOTIFICATION_DUE_DAYS": "3",
          "UPLOAD_DIR": "/app/uploads",
          "ALLOWED_ORIGINS": "http://localhost:{FRONTEND_HOST_PORT}"
        }
      }
    ],
    "env_keys": {
      "container_prefix": "BUSANA_CONTAINER_PREFIX",
      "frontend_host_port": "FRONTEND_HOST_PORT",
      "backend_host_port": "BACKEND_HOST_PORT",
      "sqlite_web_host_port": "SQLITE_WEB_HOST_PORT",
      "db_volume": "BUSANA_DB_VOLUME",
      "frontend_node_modules_volume": "BUSANA_FRONTEND_NODE_MODULES_VOLUME",
      "vite_dev_port": "VITE_DEV_PORT",
      "playwright_base_url": "PW_BASE_URL",
      "playwright_output_dir": "PW_OUTPUT_DIR",
      "playwright_json_output": "PW_JSON_OUTPUT",
      "playwright_html_report": "PW_HTML_REPORT",
      "playwright_screenshots": "PW_SCREENSHOT_DIR"
    },
    "env_values": {
      "BUSANA_BACKEND_ENV_FILE": "backend/.env.ticket"
    },
    "volume_prefixes": {
      "db": "busana_db",
      "frontend_node_modules": "busana_frontend_node_modules"
    },
    "vite_dev_port": "5173"
  },
  "git": {
    "branch_prefix": "tdd/",
    "commit_scope": "tdd",
    "commit_default": true
  },
  "pr": {
    "provider": "github"
  },
  "portability_audit": {
    "forbidden_reusable_patterns": [
      "\\b(?:Costume Rental|Costume-Rent|catalogue|CATALOGUE|rental|RENT|busana|BUSANA|Baju Adat|admin@busana\\.com)\\b",
      "(?:PLAN-20260517|TICKET-20260517|CATALOGUE-\\d{3}|RENT-\\d{3}|CLIENT-\\d{3}|AUTH-\\d{3}|SETTINGS-\\d{3}|NOTIFICATION-\\d{3}|NAVIGATION-\\d{3})",
      "\\bBUSANA_[A-Z0-9_]+\\b|\\bbusana_[a-z0-9_]+\\b"
    ]
  },
  "agent_permissions": {
    "developer": {
      "read": [
        "backend/**",
        "frontend/**",
        "docs/tickets/**",
        "docs/acceptance/**",
        ".opencode/state/test-case-manifest.json"
      ],
      "write": [
        "backend/**",
        "frontend/**"
      ],
      "deny": [
        "test/**"
      ]
    },
    "sdet": {
      "read": [
        "test/**",
        "docs/acceptance/**",
        ".opencode/project.json"
      ],
      "write": [
        "test/**",
        ".opencode/state/test-case-manifest.json"
      ],
      "deny": [
        "backend/**",
        "frontend/**"
      ]
    },
    "reviewer": {
      "read": [
        "**/*"
      ],
      "write": []
    },
    "workflow-engineer": {
      "read": [
        ".opencode/**",
        "docs/**",
        "test/**",
        "AGENTS.md"
      ],
      "write": [
        ".opencode/**",
        "docs/**",
        "test/**",
        "AGENTS.md"
      ],
      "deny": [
        "backend/**",
        "frontend/**"
      ]
    },
    "orchestrator": {
      "read": [
        "docs/tickets/**",
        "docs/acceptance/**",
        "docs/plans/**",
        ".opencode/state/*.json",
        ".opencode/state.example/*.json",
        ".opencode/skills/**",
        ".opencode/project.json",
        "test/**",
        "backend/**",
        "frontend/**"
      ],
      "write": [
        "docs/tickets/**",
        "docs/plans/**",
        ".opencode/state/*.json",
        ".opencode/state/worker-outputs/**",
        ".opencode/logs/workflow-runs/**",
        ".opencode/state.example/*"
      ],
      "deny": [
        ".opencode/opencode.json"
      ]
    }
  }
}
