{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "backend/vendor/**",
      "backend/*.exe",
      "*.db",
      "frontend/dist/**",
      "frontend/build/**",
      "test/test-results/**",
      "*.log",
      ".git/**"
    ]
  },
  "permission": {
    "skill": {
      "sdet": "allow",
      "engineer": "allow",
      "orchestrator": "allow",
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "context": {
    "include": ["backend/", "frontend/src/", "test/", "docs/", ".opencode/skills/", ".opencode/knowledge/"],
    "exclude": ["backend/server", "frontend/node_modules/", "test/test-results/", "*.db", "*.webm"]
  }
}
