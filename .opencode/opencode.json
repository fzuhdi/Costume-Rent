{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "backend/vendor/**",
      "backend/*.exe",
      "*.db",
      "frontend/dist/**",
      "frontend/build/**",
      "test/test-results/**",
      "*.log",
      ".git/**"
    ]
  },
  "permission": {
    "skill": {
      "sdet": "allow",
      "engineer": "allow",
      "orchestrator": "allow",
      "*": "allow"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "heroui-react": {
      "type": "local",
      "command": ["npx", "-y", "@heroui/react-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
