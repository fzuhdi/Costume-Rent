{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "backend/vendor/**",
      "backend/*.exe",
      "*.db",
      "frontend/dist/**",
      "frontend/build/**",
      ".artifacts/**",
      ".playwright-mcp/**",
      "test-results/**",
      "playwright-report/**",
      "test/test-results/**",
      "test/test-results-*/**",
      "test/playwright-report/**",
      "test/playwright-report-*/**",
      "*.log",
      ".git/**"
    ]
  },
  "permission": {
    "task": {
      "*": "deny",
      "explore": "allow",
      "general": "allow",
      "developer": "allow",
      "sdet": "allow",
      "reviewer": "allow",
      "workflow-engineer": "allow",
      "orchestrator": "allow"
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
