{
  "name": "costume-rental-tests",
  "version": "1.0.0",
  "description": "Playwright tests for Costume Rental with Page Object Model",
  "scripts": {
    "test": "npx playwright test",
    "regression:sync-bugs": "node helpers/sync-regression-bugs.mjs",
    "regression:sync-bugs:dry": "node helpers/sync-regression-bugs.mjs --dry-run",
    "legacy:sync-failures": "node helpers/sync-failure-log.mjs",
    "quality:integrity": "node ../scripts/quality-gate.mjs",
    "quality:e2e": "npx playwright test",
    "quality:full": "node ../scripts/quality-gate.mjs && npx playwright test",
    "ui:smoke": "npx playwright test --project=ui:smoke",
    "ui:review": "npx playwright test --project=ui:review",
    "e2e:tdd": "npx playwright test --project=e2e:tdd",
    "api": "npx playwright test --project=api",
    "visual": "npx playwright test --project=visual",
    "test:auth": "npx playwright test specs/auth.spec.js",
    "test:catalogue": "npx playwright test specs/catalogue.spec.js",
    "test:rental": "npx playwright test specs/rental.spec.js",
    "test:feature": "node helpers/run-feature.js",
    "test:specific": "node helpers/run-specific.js",
    "test:headed": "npx playwright test --headed --slow-mo 500",
    "test:list": "npx playwright test --list",
    "test:report": "npx playwright show-report",
    "test:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
