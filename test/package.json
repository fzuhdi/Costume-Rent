{
  "name": "costume-rental-tests",
  "version": "1.0.0",
  "description": "Playwright tests for Costume Rental with Page Object Model",
  "scripts": {
    "test": "npx playwright test || true && node helpers/sync-bug-reports.js",
    "test:feature": "node helpers/run-feature.js",
    "test:specific": "node helpers/run-specific.js",
    "test:headed": "npx playwright test --headed --slow-mo 500",
    "test:list": "npx playwright test --list",
    "test:report": "npx playwright show-report",
    "test:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
